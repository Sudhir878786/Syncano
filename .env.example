# Environment Configuration for Melodexa

# ============================================
# BACKEND ENVIRONMENT VARIABLES (Render)
# ============================================

# Flask Configuration
FLASK_ENV=production
SECRET_KEY=your-super-secret-key-change-this-in-production
HOST=0.0.0.0
PORT=10000

# Frontend URL (Vercel deployment URL)
FRONTEND_URL=https://your-app.vercel.app

# CORS Configuration (allow Vercel domains)
CORS_ORIGINS=https://*.vercel.app,https://your-app.vercel.app

# Upstash Redis Configuration
# Get this from: https://console.upstash.com/
REDIS_URL=rediss://default:your-password@your-endpoint.upstash.io:6379
REDIS_SSL=true

# Logging
LOG_LEVEL=INFO

# ============================================
# FRONTEND ENVIRONMENT VARIABLES (Vercel)
# ============================================

# Backend URL (Render deployment URL)
BACKEND_URL=https://your-backend.onrender.com

# ============================================
# LOCAL DEVELOPMENT
# ============================================

# For local development, use these values:
# FLASK_ENV=development
# SECRET_KEY=dev-secret-key
# HOST=0.0.0.0
# PORT=10000
# FRONTEND_URL=http://localhost:5173
# BACKEND_URL=http://localhost:10000
# CORS_ORIGINS=*
# REDIS_URL=redis://localhost:6379  (or use your Upstash Redis URL)
# LOG_LEVEL=DEBUG
